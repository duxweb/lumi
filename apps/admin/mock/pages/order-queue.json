{
  "root": "page",
  "state": {
    "queue": {
      "data": [],
      "total": 0,
      "loading": true,
      "error": null
    },
    "status": "paid"
  },
  "elements": {
    "page": {
      "type": "Card",
      "props": {
        "title": {
          "$t": "Order queue"
        },
        "description": {
          "$t": "Served by GET /pages/order-queue. The backend owns this layout; the front end ships no page code for it."
        }
      },
      "children": [
        "status",
        "query",
        "error",
        "table",
        "refresh"
      ]
    },
    "status": {
      "type": "FormField",
      "props": {
        "name": "status",
        "label": {
          "$t": "Status"
        },
        "fieldType": "enum",
        "widget": "Select",
        "options": [
          {
            "label": {
              "$t": "Paid · to ship"
            },
            "value": "paid"
          },
          {
            "label": {
              "$t": "Pending payment"
            },
            "value": "pending"
          },
          {
            "label": {
              "$t": "Shipped"
            },
            "value": "shipped"
          }
        ],
        "value": {
          "$bindState": "/status"
        }
      },
      "children": []
    },
    "query": {
      "type": "Query",
      "props": {
        "resource": "orders",
        "operation": "list",
        "pagination": {
          "page": 1,
          "pageSize": 5
        },
        "filters": [
          {
            "field": "status",
            "operator": "eq",
            "value": {
              "$state": "/status"
            }
          }
        ],
        "sorters": [
          {
            "field": "total",
            "order": "desc"
          }
        ],
        "resultPath": "/queue"
      },
      "children": []
    },
    "error": {
      "type": "Alert",
      "props": {
        "tone": "danger",
        "title": {
          "$t": "Orders unavailable"
        },
        "message": {
          "$t": "Refresh to try again."
        }
      },
      "visible": {
        "$state": "/queue/error"
      },
      "children": []
    },
    "table": {
      "type": "Table",
      "props": {
        "rows": {
          "$state": "/queue/data"
        },
        "loading": {
          "$state": "/queue/loading"
        },
        "total": {
          "$state": "/queue/total"
        },
        "columns": [
          {
            "field": "number",
            "label": {
              "$t": "Order"
            },
            "kind": "code",
            "width": "9rem"
          },
          {
            "field": "customer",
            "label": {
              "$t": "Customer"
            },
            "truncate": true
          },
          {
            "field": "status",
            "label": {
              "$t": "Status"
            },
            "kind": "badge",
            "width": "8rem",
            "valueMap": {
              "paid": {
                "$t": "Paid"
              },
              "pending": {
                "$t": "Pending"
              },
              "shipped": {
                "$t": "Shipped"
              }
            },
            "toneMap": {
              "paid": "warning",
              "pending": "neutral",
              "shipped": "success"
            }
          },
          {
            "field": "total",
            "label": {
              "$t": "Total"
            },
            "kind": "currency",
            "currency": "USD",
            "align": "right",
            "width": "8rem"
          }
        ]
      },
      "children": []
    },
    "refresh": {
      "type": "Button",
      "props": {
        "label": {
          "$t": "Refresh"
        },
        "appearance": "outline"
      },
      "on": {
        "press": {
          "action": "invalidate",
          "params": {
            "resource": "orders"
          }
        }
      },
      "children": []
    }
  }
}
