        "tooltip": true,
        "suffix": "%",
        "ariaLabel": {
          "$t": "Volume"
        }
      },
      "children": []
    },
    "slider-price": {
      "type": "Slider",
      "props": {
        "value": {
          "$bindState": "/values/price"
        },
        "min": 0,
        "max": 1000,
        "step": 10,
        "minStepsBetweenThumbs": 5,
        "input": true,
        "prefix": "¥",
        "tooltip": true,
        "ariaLabel": {
          "$t": "Price range"
        }
      },
      "children": []
    },
    "slider-quality": {
      "type": "Slider",
      "props": {
        "value": {
          "$bindState": "/values/quality"
        },
        "step": 25,
        "tooltip": true,
        "ariaLabel": {
          "$t": "Quality"
        },
        "marks": [
          {
            "value": 0,
            "label": {
              "$t": "Low"
            }
          },
          {
            "value": 25
          },
          {
            "value": 50,
            "label": {
              "$t": "Medium"
            }
          },
          {
            "value": 75
          },
          {
            "value": 100,
            "label": {
              "$t": "High"
            }
          }
        ]
