          {
            "value": "free",
            "label": {
              "$t": "Free"
            }
          },
          {
            "value": "pro",
            "label": {
              "$t": "Pro"
            }
          },
          {
            "value": "team",
            "label": {
              "$t": "Team"
            }
          }
        ],
        "defaultValue": "pro"
