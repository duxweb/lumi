        "fieldType": "string",
        "widget": "Textarea",
        "autoResize": true,
        "rows": 2,
        "defaultValue": {
          "$t": "Grows as you type more lines"
        }
      },
      "children": []
    },
    "field-select": {
      "type": "FormField",
      "props": {
        "name": "select",
        "label": {
          "$t": "Select"
        },
        "fieldType": "string",
        "widget": "Select",
        "options": [
          {
            "value": "cn",
            "label": {
              "$t": "China"
            }
          },
          {
            "value": "jp",
            "label": {
              "$t": "Japan"
            }
          },
          {
            "value": "de",
            "label": {
              "$t": "Germany"
            }
          },
          {
            "value": "us",
