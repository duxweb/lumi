    "column-text": {
      "type": "Stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "field-static",
        "field-text",
        "field-password",
        "field-disabled",
        "field-readonly",
        "field-required",
        "field-textarea",
        "field-auto-resize-textarea"
      ]
    },
    "column-selection": {
      "type": "Stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "field-select",
        "field-select-with-search",
        "field-select-with-prefix",
        "field-multiple-select",
        "field-cascader",
        "field-number-with-unit",
        "field-number-with-suffix",
