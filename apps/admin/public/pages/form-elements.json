        "widget": "Select",
        "options": [
          {
            "value": "cn",
            "label": {
              "$t": "China"
            }
          },
          {
            "value": "jp",
            "label": {
              "$t": "Japan"
            }
          },
          {
            "value": "de",
            "label": {
              "$t": "Germany"
            }
          },
          {
            "value": "us",
            "label": {
              "$t": "United States"
