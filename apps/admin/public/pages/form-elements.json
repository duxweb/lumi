{
  "root": "page",
  "elements": {
    "page": {
      "type": "Page",
      "props": {
        "ariaLabel": {
          "$t": "Form elements"
        },
        "stack": true
      },
      "children": [
        "header",
        "elements-card",
        "detail-grid"
      ]
    },
    "static-text": {
      "type": "Text",
      "props": {
        "text": {
          "$t": "admin@lumi.dev"
        }
      },
      "children": []
    },
    "field-static": {
      "type": "FormField",
      "props": {
        "name": "static",
        "label": {
          "$t": "Static"
        }
      },
      "children": [
        "static-text"
      ]
    },
    "field-text": {
      "type": "FormField",
      "props": {
        "name": "text",
        "label": {
          "$t": "Text"
        },
        "placeholder": {
          "$t": "Your name"
        }
      },
      "children": []
    },
    "field-password": {
      "type": "FormField",
      "props": {
        "name": "password",
        "label": {
          "$t": "Password"
        },
        "type": "password",
        "defaultValue": "lumi-secret"
      },
      "children": []
    },
    "field-disabled": {
      "type": "FormField",
      "props": {
        "name": "disabled",
        "label": {
          "$t": "Disabled"
        },
        "placeholder": {
          "$t": "Not editable"
        },
        "disabled": true
      },
      "children": []
    },
    "field-readonly": {
      "type": "FormField",
      "props": {
        "name": "readonly",
        "label": {
          "$t": "Readonly"
        },
        "defaultValue": "LUMI-2026-0817",
        "readonly": true
      },
      "children": []
    },
    "field-required": {
      "type": "FormField",
      "props": {
        "name": "required",
        "label": {
          "$t": "Required"
        },
        "placeholder": {
          "$t": "Shown with a marker"
        },
        "required": true
      },
      "children": []
    },
    "field-clearable": {
      "type": "FormField",
      "props": {
        "name": "clearable",
        "label": {
          "$t": "Clearable"
        },
        "clearable": true,
        "defaultValue": {
          "$t": "Clear me"
        }
      },
      "children": []
    },
    "field-textarea": {
      "type": "FormField",
      "props": {
        "name": "textarea",
        "label": {
          "$t": "Textarea"
        },
        "fieldType": "string",
        "widget": "Textarea",
        "rows": 3,
        "placeholder": {
          "$t": "Tell us about the order…"
        },
        "help": {
          "$t": "Up to 500 characters"
