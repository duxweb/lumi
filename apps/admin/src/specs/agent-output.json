{
  "root": "page",
  "state": {
    "pending": {
      "data": [],
      "total": 0,
      "loading": true,
      "error": null
    },
    "minTotal": 100
  },
  "elements": {
    "page": {
      "type": "Card",
      "props": {
        "title": {
          "$t": "Unpaid orders to follow up"
        },
        "description": {
          "$t": "Generated by the agent from the prompt \"show me large unpaid orders\". Only Catalog components and registered actions are used"
        }
      },
      "children": [
        "threshold",
        "query",
        "error",
        "table",
        "refresh"
      ]
    },
    "threshold": {
      "type": "FormField",
      "props": {
        "name": "minTotal",
        "label": {
          "$t": "Minimum total (USD)"
        },
        "fieldType": "number",
        "value": {
          "$bindState": "/minTotal"
        }
      },
      "children": []
    },
    "query": {
      "type": "Query",
      "props": {
        "resource": "orders",
        "operation": "list",
        "pagination": {
          "page": 1,
          "pageSize": 5
        },
        "filters": [
          {
            "field": "status",
            "operator": "eq",
            "value": "pending"
          },
          {
            "field": "total",
            "operator": "gte",
            "value": {
              "$state": "/minTotal"
            }
          }
        ],
        "sorters": [
          {
            "field": "total",
            "order": "desc"
          }
        ],
        "resultPath": "/pending"
      },
      "children": []
    },
    "error": {
      "type": "Alert",
      "props": {
        "tone": "danger",
        "title": {
          "$t": "Orders unavailable"
        },
        "message": {
          "$t": "Refresh to try again"
        }
      },
      "visible": {
        "$state": "/pending/error"
      },
      "children": []
    },
    "table": {
      "type": "Table",
      "props": {
        "rows": {
          "$state": "/pending/data"
        },
        "loading": {
          "$state": "/pending/loading"
        },
        "total": {
          "$state": "/pending/total"
        },
        "columns": [
          {
            "field": "number",
            "label": {
              "$t": "Order"
            },
            "kind": "code",
            "width": "9rem"
          },
          {
            "field": "customer",
            "label": {
              "$t": "Customer"
            },
            "truncate": true
          },
          {
            "field": "total",
            "label": {
              "$t": "Total"
            },
            "kind": "currency",
            "currency": "USD",
            "align": "right",
            "width": "8rem"
          }
        ]
      },
      "children": []
    },
    "refresh": {
      "type": "Button",
      "props": {
        "label": {
          "$t": "Refresh"
        },
        "appearance": "outline"
      },
      "on": {
        "press": {
          "action": "invalidate",
          "params": {
            "resource": "orders"
          }
        }
      },
      "children": []
    }
  }
}
