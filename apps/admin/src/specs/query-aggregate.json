{
  "root": "stack",
  "state": {
    "status": "",
    "summary": {
      "data": null,
      "loading": true
    },
    "products": {
      "data": [],
      "total": 0,
      "loading": true
    }
  },
  "elements": {
    "stack": {
      "type": "Stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "filter",
        "summary-query",
        "strip",
        "list-query",
        "table"
      ]
    },
    "filter": {
      "type": "Segmented",
      "props": {
        "ariaLabel": {
          "$t": "Status"
        },
        "value": {
          "$bindState": "/status"
        },
        "options": [
          {
            "value": "",
            "label": {
              "$t": "All"
            }
          },
          {
            "value": "active",
            "label": {
              "$t": "Active"
            }
          },
          {
            "value": "draft",
            "label": {
              "$t": "Draft"
            }
          },
          {
            "value": "archived",
            "label": {
              "$t": "Archived"
            }
          }
        ]
      },
      "children": []
    },
    "summary-query": {
      "type": "Query",
      "props": {
        "resource": "products",
        "operation": "custom",
        "url": "/products/aggregate",
        "query": {
          "status": {
            "$state": "/status"
          }
        },
        "resultPath": "/summary"
      },
      "children": []
    },
    "strip": {
      "type": "StatStrip",
      "props": {
        "ariaLabel": {
          "$t": "Catalog summary"
        },
        "items": [
          {
            "key": "products",
            "label": {
              "$t": "Products"
            },
            "value": {
              "$state": "/summary/data/products"
            }
          },
          {
            "key": "active",
            "label": {
              "$t": "Active"
            },
            "value": {
              "$state": "/summary/data/active"
            }
          },
          {
            "key": "draft",
            "label": {
              "$t": "Draft"
            },
            "value": {
              "$state": "/summary/data/draft"
            }
          }
        ]
      },
      "children": []
    },
    "list-query": {
      "type": "Query",
      "props": {
        "resource": "products",
        "pagination": {
          "page": 1,
          "pageSize": 4
        },
        "filters": [
          {
            "field": "status",
            "operator": "eq",
            "value": {
              "$state": "/status"
            }
          }
        ],
        "resultPath": "/products"
      },
      "children": []
    },
    "table": {
      "type": "Table",
      "props": {
        "rows": {
          "$state": "/products/data"
        },
        "loading": {
          "$state": "/products/loading"
        },
        "columns": [
          {
            "field": "name",
            "label": {
              "$t": "Product"
            }
          },
          {
            "field": "status",
            "label": {
              "$t": "Status"
            },
            "kind": "badge",
            "valueMap": {
              "active": {
                "$t": "Active"
              },
              "draft": {
                "$t": "Draft"
              },
              "archived": {
                "$t": "Archived"
              }
            },
            "toneMap": {
              "active": "success",
              "draft": "warning",
              "archived": "neutral"
            }
          },
          {
            "field": "price",
            "label": {
              "$t": "Price"
            },
            "kind": "currency",
            "currency": "USD"
          }
        ]
      },
      "children": []
    }
  }
}
