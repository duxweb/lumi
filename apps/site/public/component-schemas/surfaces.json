      },
      "children": []
    },
    "dialog-20-trigger": {
      "type": "Button",
      "props": {
        "label": "Open large dialog",
        "appearance": "outline"
      },
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/dialog-20/open",
            "value": true
          }
        }
      },
      "children": []
    },
    "dialog-20-content": {
      "type": "Alert",
      "props": {
        "tone": "neutral",
        "message": "This is an interactive overlay. Close it with the close button or Escape."
      },
      "children": []
    },
    "drawer-23-trigger": {
      "type": "Button",
      "props": {
        "label": "Open side drawer",
        "appearance": "outline"
      },
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/drawer-23/open",
            "value": true
          }
        }
      },
      "children": []
    },
    "drawer-23-content": {
      "type": "Alert",
      "props": {
        "tone": "neutral",
        "message": "This is an interactive overlay. Close it with the close button or Escape."
      },
      "children": []
    },
    "drawer-24-trigger": {
      "type": "Button",
      "props": {
        "label": "Open bottom drawer",
        "appearance": "outline"
      },
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/drawer-24/open",
            "value": true
          }
        }
      },
      "children": []
    },
    "drawer-24-content": {
      "type": "Alert",
      "props": {
        "tone": "neutral",
        "message": "This is an interactive overlay. Close it with the close button or Escape."
      },
      "children": []
    },
    "tab-alpha": {
      "type": "Alert",
      "props": {
        "message": "Alpha tab content",
        "tone": "neutral"
      },
      "visible": {
        "$state": "/tabs-16/value",
        "eq": "alpha"
      },
      "children": []
    },
    "tab-beta": {
      "type": "Alert",
      "props": {
        "message": "Beta tab content",
        "tone": "neutral"
      },
      "visible": {
        "$state": "/tabs-16/value",
        "eq": "beta"
      },
      "children": []
    },
    "card-interactive": {
      "type": "Card",
      "props": {
        "title": "Menus and hints",
        "description": "A command menu, a hint on an icon button and folding sections."
      },
      "children": [
        "fragment-interactive"
      ]
    },
    "fragment-interactive": {
      "type": "Fragment",
      "props": {
        "layout": "stack"
      },
      "children": [
        "toolbar-interactive",
        "accordion-1"
      ]
    },
    "toolbar-interactive": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "menu-1",
        "tooltip-1"
      ]
    },
    "menu-1": {
      "type": "Menu",
      "props": {
        "label": "Order actions",
        "value": {
          "$bindState": "/menu-1/value"
        },
        "items": [
          {
            "key": "edit",
            "label": "Edit",
            "icon": "pencil"
          },
          {
            "key": "duplicate",
            "label": "Duplicate",
            "icon": "copy"
          },
          {
            "key": "delete",
            "label": "Delete",
            "icon": "trash-2",
            "tone": "danger",
            "separatorBefore": true
          }
        ]
      },
      "children": []
    },
    "tooltip-1": {
      "type": "Tooltip",
      "props": {
        "content": "Download as CSV"
      },
      "children": [
        "tooltip-1-button"
      ]
    },
    "tooltip-1-button": {
      "type": "Button",
      "props": {
        "label": "Export",
        "icon": "download",
        "shape": "square",
        "appearance": "outline"
      },
      "children": []
    },
    "accordion-1": {
      "type": "Accordion",
      "props": {
        "defaultOpen": [
          "returns"
        ],
        "items": [
          {
            "key": "returns",
            "title": "How do returns work?",
            "content": "Customers have 14 days to start a return from their order page."
          },
          {
            "key": "invoices",
            "title": "Where are invoices?",
            "content": "Every paid order has a PDF invoice under its detail page."
          }
        ]
      },
      "children": []
    }
  },
  "state": {
    "tabs-16": {
      "value": "alpha"
    },
    "dialog-19": {
      "open": false
    },
    "dialog-20": {
      "open": false
    },
    "drawer-23": {
      "open": false
    },
    "drawer-24": {
      "open": false
    },
    "drawer-wide": {
      "open": false
    },
    "drawer-left": {
      "open": false
    },
    "menu-1": {
      "value": ""
    }
  }
