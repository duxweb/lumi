---
import type { Locale } from '../i18n'
import { COPY } from '../i18n'
import Base from '../layouts/Base.astro'
import { sitePath } from '../paths'
import { Stage } from './Stage'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = COPY[locale]
const command = 'pnpm create @duxweb/lumi my-admin'
const pillars = t.pillars.items
// Top to bottom: each layer uses only the ones below it.
const names = ['@duxweb/lumi-admin', '@duxweb/lumi-ui', '@duxweb/lumi', 'json-render']
const layers = t.arch.layers.map((layer, index) => ({ ...layer, name: names[index]!, upstream: index === names.length - 1 }))
---

<Base locale={locale} title={t.title} description={t.description} night>
  <main>
    <section class="hero">
      <p class="hero__tag">{t.hero.tag}</p>
      <h1>{t.hero.title[0]}<br />{t.hero.title[1]}</h1>
      <p class="hero__lede">
        {t.hero.lede}
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href={sitePath('/guide/getting-started/')}>{t.hero.start}</a>
        <a class="button" href={sitePath('/playground/')}>{t.hero.playground}</a>
      </div>
      <button class="command" type="button" data-copy={command} aria-label={t.hero.copy}>
        <code>{command}</code>
        <span class="command__done" aria-hidden="true">{t.hero.copied}</span>
      </button>
    </section>

    <section class="wide showcase" aria-label={t.showcase.label}>
      <div class="stage-slot"><Stage client:only="react" locale={locale} /></div>
      <p class="showcase__note">{t.showcase.note}</p>
    </section>

    <section class="pillars">
      <div class="section-head">
        <p class="eyebrow">{t.pillars.eyebrow}</p>
 <h2 class="section-title">{t.pillars.title}</h2>
      </div>
      <div class="pillars__grid">
        {pillars.map((pillar, index) => (
          <div class="pillar">
            {index === 0 && (
              <div class="pillar__art pillar__art--lines" aria-hidden="true">
                <span class="chip chip--start">orders.json</span>
                <span class="chip chip--off chip--start">pnpm build</span>
                <span class="chip chip--good chip--end">↻ 0.2s</span>
              </div>
            )}
            {index === 1 && (
              <div class="pillar__art" aria-hidden="true">
                {['Table', 'Form', 'Chart', 'Tabs', 'Upload', 'Drawer'].map(name => <span class="chip">{name}</span>)}
              </div>
            )}
            {index === 2 && (
              <div class="pillar__art pillar__art--lines" aria-hidden="true">
                <span class="chip chip--bad">✕ /columns/0/kind</span>
                <span class="chip chip--good">✓ orders.json</span>
              </div>
            )}
            {index === 3 && (
              <div class="pillar__art pillar__art--lines" aria-hidden="true">
                <span class="chip chip--end">@orders/2031</span>
                <span class="chip chip--start">/ship</span>
                <span class="chip chip--solid chip--end">✓ {t.flow.art.approve}</span>
              </div>
            )}
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="flow" id="ai">
      <div class="flow__head">
        <div>
   <p class="eyebrow">{t.flow.eyebrow}</p>
          <h2 class="section-title">{t.flow.title}</h2>
 </div>
        <p class="flow__lede">{t.flow.lede}</p>
      </div>
      <div class="flow__grid">
        {t.flow.columns.map((column, index) => (
          <div class="flow__column">
            <div class="flow__art" aria-hidden="true">
       {index === 0 && (
         <div class="glass glass--mono">
    <span>$ {t.flow.art.command}</span>
    <span>$ {t.flow.art.output}</span>
           <span>✓ {t.flow.art.valid}</span>
  </div>
       )}
       {index === 1 && (
         <div class="glass">
           <p class="glass__title">{t.flow.art.card}</p>
    <div class="glass__bars"><i /><i /></div>
    <div class="glass__actions">
      <span class="glass__button glass__button--solid">{t.flow.art.approve}</span>
      <span class="glass__button">{t.flow.art.edit}</span>
    </div>
  </div>
       )}
     </div>
            <p class="flow__stage"><strong>{column.stage}</strong>{column.lede}</p>
            <ul class="flow__list">
              {column.items.map(item => <li><span class="flow__name">{item.name}</span><span>{item.text}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="arch">
      <div class="section-head">
        <p class="eyebrow">{t.arch.eyebrow}</p>
 <h2 class="section-title">{t.arch.title}</h2>
 <p class="section-lede">{t.arch.lede}</p>
      </div>
      <div class="arch__stack">
        {layers.map(layer => (
          <div class:list={['arch__layer', { 'arch__layer--upstream': layer.upstream }]}>
            <span class="arch__role">{layer.role}</span>
            <code class="arch__name">{layer.name}</code>
            <span class="arch__text">{layer.text}</span>
          </div>
        ))}
      </div>
      <div class="arch__backend">
        <span class="arch__role">{t.arch.backend.role}</span>
        <span class="arch__text">{t.arch.backend.text}</span>
      </div>
    </section>

    <section class="closing">
      <p class="closing__line">{t.closing.line}</p>
      <div class="hero__actions">
        <a class="button button--solid" href={sitePath('/guide/getting-started/')}>{t.closing.docs}</a>
        <a class="button" href={sitePath('/demo/')}>{t.closing.demo}</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <span>{t.footer}</span>
    <a href="https://github.com/duxweb">GitHub</a>
  </footer>

  <script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', () => {
        void navigator.clipboard.writeText(button.dataset.copy ?? '').then(() => {
          button.dataset.copied = ''
          setTimeout(() => delete button.dataset.copied, 1600)
        }, () => {})
      })
    }
  </script>
</Base>
