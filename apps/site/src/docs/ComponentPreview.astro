---
import { GALLERY_PAGES } from '@duxweb/lumi-schema-gallery'
import { sitePath } from '../paths'
import { DocPreview } from './DocPreview'
import { focusComponentDemo } from './focus'

// The live preview above a component page. The page's own Markdown carries the
// same example as JSON, so readers without the site lose nothing.
interface Props { name: string }
const { name } = Astro.props
const preview = Object.values(GALLERY_PAGES).map(page => focusComponentDemo(page.spec, name)).find(Boolean)
const playground = preview ? `${sitePath('/playground/')}#schema=${encodeURIComponent(JSON.stringify(preview))}` : undefined
---
{preview && (
  <section class="ref__demo" aria-label="预览" data-component-preview={name}>
    <div class="ref__stage"><DocPreview client:visible spec={preview} /></div>
    <a class="ref__open" href={playground}>在 Playground 里改</a>
  </section>
)}
