---
import type { MarkdownHeading } from 'astro'
import type { DocsSection } from '../docs/nav'
import { neighbours } from '../docs/nav'
import { sitePath } from '../paths'
import Base from './Base.astro'
import '../styles/docs.css'

interface Props {
  title: string
  description?: string
  slug: string
  section: DocsSection
  headings: MarkdownHeading[]
}
const { title, description, slug, section, headings } = Astro.props
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3)
const { prev, next } = neighbours(section, slug)
const href = (target: string): string => sitePath(`/${target}/`)
---

<Base locale="zh" title={`${title} - Lumi`} description={description ?? title} wide active={section.id}>
  <div class="docs">
    <div class="docs__body">
      <aside class="docs__sidebar" aria-label={`${section.label}目录`}>
        {section.groups.map(group => (
          <div class="docs__group">
            <p class="docs__group-label">{group.label}</p>
            <ul>
              {group.items.map(item => <li><a href={href(item.slug)} aria-current={item.slug === slug ? 'page' : undefined}>{item.label}</a></li>)}
            </ul>
          </div>
        ))}
      </aside>
      <details class="docs__menu">
        <summary>{section.label}目录</summary>
        {section.groups.map(group => (
          <div class="docs__group">
            <p class="docs__group-label">{group.label}</p>
            <ul>
              {group.items.map(item => <li><a href={href(item.slug)} aria-current={item.slug === slug ? 'page' : undefined}>{item.label}</a></li>)}
            </ul>
          </div>
        ))}
      </details>
      <article class:list={['docs__main', { 'docs__main--full': toc.length < 2 }]}>
        <p class="docs__crumb">{section.label}</p>
        <h1>{title}</h1>
        <div class="prose"><slot /></div>
        {(prev || next) && (
          <nav class="docs__pager" aria-label="上一篇和下一篇">
            {prev ? <a href={href(prev.slug)}><small>上一篇</small>{prev.label}</a> : <span />}
            {next && <a class="docs__pager-next" href={href(next.slug)}><small>下一篇</small>{next.label}</a>}
          </nav>
        )}
      </article>
      {toc.length > 1 && (
        <aside class="docs__toc" aria-label="本页目录">
          <p class="docs__group-label">本页内容</p>
          <ul>{toc.map(heading => <li data-depth={heading.depth}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
        </aside>
      )}
    </div>
  </div>
  <script is:inline>
    (() => {
      const body = document.querySelector('.docs__body')
      const sidebar = document.querySelector('.docs__sidebar')
      // How much of the window the header still takes, so the side columns end at the window's edge.
      const measure = () => document.documentElement.style.setProperty('--docs-top', `${Math.max(0, Math.round(body.getBoundingClientRect().top))}px`)
      measure()
      addEventListener('scroll', measure, { passive: true })
      addEventListener('resize', measure)
      // Open with the current page in view, without moving the page itself.
      const current = sidebar.querySelector('a[aria-current]')
      if (current) {
        const offset = current.getBoundingClientRect().top - sidebar.getBoundingClientRect().top
        sidebar.scrollTop += offset - (sidebar.clientHeight - current.offsetHeight) / 2
      }
    })()
  </script>
  <footer class="footer docs__footer">
    <span>Lumi，MIT 许可</span>
    <a href="https://github.com/duxweb">GitHub</a>
  </footer>
</Base>
