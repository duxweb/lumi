---
import Base from '../layouts/Base.astro'
---

<Base locale="zh" title="页面不存在 - Lumi" description="这个地址没有页面。">
  <script is:inline>
    // The demo admin is a single-page app under /demo/: a static host has no
    // file for its inner routes, so hand the path to the app to open itself.
    // `/demo/` itself landing here means the host has no demo to hand over to:
    // sending it there again would reload this page forever.
    if (location.pathname.startsWith('/demo/') && location.pathname !== '/demo/') {
      try {
        sessionStorage.setItem('lumi-admin-redirect', location.pathname + location.search + location.hash)
      }
      catch {}
      location.replace('/demo/')
    }
  </script>
  <section class="missing">
    <h1>页面不存在</h1>
    <p>这个地址没有页面，可能已经移动或删除。</p>
    <p><a href="/guide/">看指南</a> 或 <a href="/">回到首页</a></p>
  </section>
</Base>

<style>
  .missing {
    max-width: 36rem;
    margin: 0 auto;
    padding-block: 8rem 6rem;
    padding-inline: 1.5rem;
    color: var(--site-ink);
  }
  .missing h1 {
    margin: 0 0 0.75rem;
    font-size: 2rem;
  }
  .missing p {
    margin: 0.5rem 0;
    color: var(--site-muted);
  }
  .missing a {
    color: var(--site-accent);
  }
</style>
