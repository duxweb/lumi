---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import ComponentPreview from '../docs/ComponentPreview.astro'
import { sectionOf } from '../docs/nav'
import Docs from '../layouts/Docs.astro'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  return entries
    .filter(entry => sectionOf(entry.id))
    .map(entry => ({ params: { slug: entry.id }, props: { entry } }))
}

interface Props { entry: CollectionEntry<'docs'> }
const { entry } = Astro.props
const { Content, headings } = await render(entry)
const section = sectionOf(entry.id)!
---

<Docs title={entry.data.title} description={entry.data.description} slug={entry.id} section={section} headings={headings}>
  <Content components={{ ComponentPreview }} />
</Docs>
