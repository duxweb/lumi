{
  "name": "@duxweb/lumi-admin",
  "type": "module",
  "version": "0.1.1",
  "description": "Native json-render Admin configuration and React application shell.",
  "author": "DuxWeb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duxweb/lumi.git",
    "directory": "packages/admin"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "lumi:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "lumi:source": "./src/catalog.ts",
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./style.css": "./dist/style.css"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown && pnpm run build:css && pnpm run build:base",
    "build:css": "tailwindcss -i src/style.css -o dist/style.css --minify",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/admin/test",
    "clean": "rimraf dist",
    "build:base": "vite build -c vite.base.config.ts"
  },
  "peerDependencies": {
    "@duxweb/lumi": "workspace:^0",
    "@duxweb/lumi-ui": "workspace:^0",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@json-render/core": "catalog:",
    "@json-render/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@duxweb/lumi": "workspace:*",
    "@duxweb/lumi-ui": "workspace:*",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@json-render/core": "catalog:",
    "@json-render/react": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  }
}
