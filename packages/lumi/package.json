{
  "name": "@duxweb/lumi",
  "type": "module",
  "version": "0.1.0",
  "description": "Native json-render integration and data services.",
  "author": "DuxWeb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duxweb/lumi.git",
    "directory": "packages/lumi"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "lumi:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "lumi:source": "./src/catalog.ts",
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./validation-json-schema": {
      "lumi:source": "./src/validation-json-schema.ts",
      "types": "./dist/validation-json-schema.d.ts",
      "import": "./dist/validation-json-schema.js",
      "default": "./dist/validation-json-schema.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run --root ../.. packages/lumi/test"
  },
  "peerDependencies": {
    "@json-render/core": "catalog:",
    "@json-render/react": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@json-render/core": "catalog:",
    "@json-render/react": "catalog:",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  }
}
